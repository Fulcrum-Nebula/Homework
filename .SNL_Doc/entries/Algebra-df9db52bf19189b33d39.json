    "id": "Algebra.prop.inverseUnique",
    "package": "Algebra",
    "kind": "property",
    "title": "逆元的唯一性",
    "content": {
      "snl": "Logic.forall-typed(@a,G@Algebra.ctxt.G,Logic.implies(Logic.exists-typed(__list__(@b_1,@b_2),G@Algebra.ctxt.G,Logic.and(Eq(,Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,a,b_1),Algebra.Id(G@Algebra.ctxt.G)),Eq(,Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,a,b_2),Algebra.Id(G@Algebra.ctxt.G)),)),Eq(,b_1,b_2)))"
    },
