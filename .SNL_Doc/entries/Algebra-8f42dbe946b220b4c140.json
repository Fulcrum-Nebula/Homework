    "kind": "theorem",
    "title": "Grothendieck Group of Commutative Monoid",
    "content": {
      "snl": "variable(__list__(Algebra.CommMonoid(G@Algebra.ctxt.G,$\\cdot$@Algebra.ctxt.mul),Type.annotation(@$\\sim$,SetRel[authored](Type.prod(G@Algebra.ctxt.G,G@Algebra.ctxt.G),Type.prod(G@Algebra.ctxt.G,G@Algebra.ctxt.G))),def[predicate](Set.Mem(,$\\sim$,Prod.mk(,,Prod.mk[authored](,,@a,@b),Prod.mk[authored](,,@c,@d))),,Logic.exists-typed(@m,G@Algebra.ctxt.G,Eq(,Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,a,b),m),Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,Fulcrum.BinaryOperation.apply[conj](,$\\cdot$@Algebra.ctxt.mul,c,d),m))))),theorem(Algebra.Abelian(quotient(Type.prod(G@Algebra.ctxt.G,G@Algebra.ctxt.G),$\\sim$),$\\cdot$@Algebra.ctxt.mul)))"
    },
